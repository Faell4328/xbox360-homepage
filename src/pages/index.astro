---
import Layout from "../layouts/Layout.astro";
import Element from "../components/Element.astro";
import Notification from "../components/Notification.astro";
import "../output.css";
import "../style/index.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    <div id="container-notice">
        <h1>Funciona apenas para computadores</h1>
        <p>
            O site foi desenvolvido para computadores e não funciona para
            celulares
        </p>
        <button id="bt-notice">Ok</button>
    </div>
    <main
        style="display: none"
        class="w-full min-h-full flex justify-center items-center"
    >
        <div class="hidden" id="container">
            <nav></nav>
            <table class="flex justify-center items-center">
                <tr>
                    <Element
                        Class="small"
                        Text="Oi"
                        Image=""
                        Icon="/disc-tray.png"
                    />
                    <Element
                        Class="big"
                        Text="Oi"
                        Icon=""
                        Image=""
                        Redirect="https://rhafaell.com.br"
                    />
                    <Element
                        Class="big"
                        Text=""
                        Icon=""
                        Image="/happy wars.jpg"
                    />
                </tr>
                <tr>
                    <Element Class="small" Text="Oi" Image="" Icon="" />
                </tr>
                <tr>
                    <Element Class="small" Text="Oi" Image="" Icon="" />
                    <Element Class="small" Text="Oi" Image="" Icon="" />
                    <Element Class="small" Text="Oi" Image="" Icon="" />
                    <Element Class="small" Text="Oi" Image="" Icon="" />
                    <Element Class="small" Text="Oi" Image="" Icon="" />
                </tr>
            </table>
        </div>
        <Notification Text="oi" />
    </main>
</Layout>
