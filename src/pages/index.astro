---
import Home from "../layouts/Home.astro";
import Menu from "../components/Menu.astro";
import Tile from "../components/Tile.astro";
import Notification from "../components/Notification.astro";
import "../output.css";
import "../style/index.css";
---

<Home>
    <main class="w-full min-h-full flex justify-center items-center">
        <Notification />
        <Menu />
        <div style="display: none;" class="hidden" id="container">
            <nav></nav>
            <table class="flex justify-center items-center">
                <tr>
                    <Tile
                        Class="small"
                        Text="Open Tray"
                        Icon="/disc-tray.png"
                    />
                    <Tile Class="small" Image="/works.png" />
                    <Tile
                        Class="small"
                        Image="/youtube.png"
                        Redirect="https://www.youtube.com/@faell4328"
                    />
                    <Tile
                        Class="big"
                        Image="/blog.png"
                        Redirect="https://rhafaell.com.br"
                    />
                </tr>
                <tr>
                    <Tile
                        Class="small"
                        Text="Favorites Games"
                        Icon="/mygames.png"
                    />
                    <Tile Class="small" Text="About me" Icon="/about.png" />
                    <Tile
                        Class="small"
                        Image="/github.png"
                        Redirect="https://github.com/Faell4328"
                    />
                </tr>
            </table>
            <footer style="position: relative;">
                <div style="position: absolute; left: 160px; display: flex; align-items: center; gap: 8px; margin-top: 40px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <img
                            id="btn-xbox-arrows"
                            style="width: 50px; height: 50px; border-radius: 100px;"
                            src="/xbox-arrows.png"
                        />
                        <p style="color: #fff; font-size: 18px; font-weight: bold;">
                            Setas
                        </p>
                    </div>
                    <div style="display: flex; align-items: center; color: #fff; gap: 8px;">
                        <img
                            id="btn-xbox-a"
                            style="width: 40px; height: 40px; border-radius: 100px;"
                            src="/xbox-a.png"
                        />
                        <p style="color: #fff; font-size: 18px; font-weight: bold;">
                            Selecionar
                        </p>
                    </div>
                    <div style="display: flex; align-items: center; color: #fff; gap: 8px;">
                        <img
                            style="width: 40px; height: 40px; border-radius: 100px;"
                            src="/xbox-b.png"
                        />
                        <p style="color: #fff; font-size: 18px; font-weight: bold;">
                            Voltar
                        </p>
                    </div>
                </div>
            </footer>
        </div>
    </main>
</Home>
