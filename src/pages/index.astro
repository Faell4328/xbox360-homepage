                    class="elemento-pai"
                    style="position: relative; background-color: #018801; width: 260px; height: 195px; border: 2px solid #4ea94f; margin: 3px; "
                >
                    <div
                        class="elemento-filho"
                        style="display: flex; align-items: center; justify-content: center; height: 100%;"
                    >
                        <img
                            style="width: 90px; height: 90px"
                            src="/disc-tray.png"
                        />
                    </div>
                    <p
                        style="position: absolute; bottom: 10px; left: 10px; font-size: 20px"
