<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <link href="../output.css" rel="stylesheet" />
        <title>Home - XBOX</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        overflow: hidden;
        width: 100vw;
        height: 100vh;
        user-select: none;
        cursor: none;
    }
</style>

<script defer>
    let control_menu_open = true;
    let tiles = [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
    ];
    let tile_index = 0;
    let tile_nodes = document.getElementsByClassName("tile");
    let undefined_key_cont = 0;
    const sounds = Object.fromEntries(
        [
            "tile-hover.wav",
            "select-a.mp3",
            "hud-open.wav",
            "startup-after-loading.wav",
            "notify-popup.wav",
            "guide-hover.wav",
        ].map((n) => {
            const a = new Audio(`/${n}`);
            a.preload = "auto";
            return [n, a];
        }),
    );

    function notify(text) {
        console.log("Chamou");

        setTimeout(() => {
            document
                .getElementById("notification-image")
                .animate(animations.pulse.keyframes, animations.pulse.options);
            document
                .getElementById("notification-container-text")
                .animate(
                    animations.expand_x.keyframes,
                    animations.expand_x.options,
                );
            document
                .getElementById("notification-text")
                .animate(animations.show.keyframes, animations.show.options);

            document.getElementById("notification-container").style =
                "opacity: 1";
            document.getElementById("notification-text").innerHTML = text;
            sounds["notify-popup.wav"].play();
        }, 600);

        setTimeout(() => {
            document
                .getElementById("notification-container-text")
                .animate(
                    animations.reducer_x.keyframes,
                    animations.reducer_x.options,
                );
            document
                .getElementById("notification-text")
                .animate(
                    animations.hidden.keyframes,
                    animations.hidden.options,
                );

            document.getElementById("notification-container").style =
                "opacity: 0";
        }, 5000);
    }

    function shine_of(element) {
        return element.querySelector(".tile-shine");
    }

    function deselect_tile(index) {
        const element = tiles[index];
        const is_big = element.className.indexOf("tile-big") > 0;
        const deselect = is_big
            ? animations.home_deselect_big
            : animations.home_deselect_small;
        element.animate(deselect.keyframes, deselect.options);
        shine_of(element)?.animate(
            animations.home_shine_out.keyframes,
            animations.home_shine_out.options,
        );
    }

    function select_tile(index, song = true) {
        const element = tiles[index];
        const is_big = element.className.indexOf("tile-big") > 0;
        const select = is_big
            ? animations.home_select_big
            : animations.home_select_small;
        element.animate(select.keyframes, select.options);
        shine_of(element)?.animate(
            animations.home_shine_in.keyframes,
            animations.home_shine_in.options,
        );
        if (song) {
            sounds["tile-hover.wav"].currentTime = 0;
            sounds["tile-hover.wav"].play();
        }
    }

    document.addEventListener("keydown", (e) => {
        if (control_menu_open == true) {
            let buttons = document.getElementsByClassName("menu-button");
            if (e.key == "ArrowUp") {
                if (
                    buttons[0].classList.contains("select-menu-button") == false
                ) {
                    buttons[1].classList.remove("select-menu-button");
                    buttons[0].classList.add("select-menu-button");
                    sounds["guide-hover.wav"].currentTime = 0;
                    sounds["guide-hover.wav"].play();
                }
            } else if (e.key == "ArrowDown") {
                if (
                    buttons[1].classList.contains("select-menu-button") == false
                ) {
                    buttons[0].classList.remove("select-menu-button");
                    buttons[1].classList.add("select-menu-button");
                    sounds["guide-hover.wav"].currentTime = 0;
                    sounds["guide-hover.wav"].play();
                }
            } else if (e.key == "a") {
                sounds["select-a.mp3"].currentTime = 0;
                sounds["select-a.mp3"].play();
                if (
                    buttons[0].classList.contains("select-menu-button") == true
                ) {
                    buttons[0].click();
                } else {
                    buttons[1].click();
                }
            }
        } else {
            if (e.key == "ArrowUp") {
                document
                    .getElementById("btn-xbox-arrows")
                    .animate(
                        animations.flash.keyframes,
                        animations.flash.options,
                    );

                if (tile_index < 5) {
                    return;
                }

                if (
                    tiles[tile_index] !=
                    tiles[tile_index - 5]
                ) {
                    deselect_tile(tile_index);
                    tile_index -= 5;
                    select_tile(tile_index);
                } else if (
                    tiles[tile_index] !=
                        tiles[tile_index - 10] &&
                    tile_index - 10 > 5
                ) {
                    deselect_tile(tile_index);
                    tile_index -= 10;
                    select_tile(tile_index);
                }

                undefined_key_cont = 0;
            } else if (e.key == "ArrowDown") {
                document
                    .getElementById("btn-xbox-arrows")
                    .animate(
                        animations.flash.keyframes,
                        animations.flash.options,
                    );

                if (tile_index >= 10) {
                    return;
                }

                if (
                    tiles[tile_index] !=
                    tiles[tile_index + 5]
                ) {
                    deselect_tile(tile_index);
                    tile_index += 5;
                    select_tile(tile_index);
                } else if (
                    tiles[tile_index] !=
                        tiles[tile_index + 10] &&
                    tile_index + 10 > 9
                ) {
                    deselect_tile(tile_index);
                    tile_index += 10;
                    select_tile(tile_index);
                }

                undefined_key_cont = 0;
            } else if (e.key == "ArrowLeft") {
                document
                    .getElementById("btn-xbox-arrows")
                    .animate(
                        animations.flash.keyframes,
                        animations.flash.options,
                    );

                if (
                    tile_index == 0 ||
                    tile_index == 5 ||
                    tile_index == 10
                ) {
                    return;
                }

                if (
                    tiles[tile_index] !=
                    tiles[tile_index - 1]
                ) {
                    deselect_tile(tile_index);
                    tile_index--;
                    select_tile(tile_index);
                } else if (
                    tiles[tile_index] !=
                        tiles[tile_index - 2] &&
                    tile_index - 2 != -1 &&
                    tile_index - 2 != 4 &&
                    tile_index - 2 != 9
                ) {
                    deselect_tile(tile_index);
                    tile_index -= 2;
                    select_tile(tile_index);
                }
                undefined_key_cont = 0;
            } else if (e.key == "ArrowRight") {
                document
                    .getElementById("btn-xbox-arrows")
                    .animate(
                        animations.flash.keyframes,
                        animations.flash.options,
                    );
                if (
                    tile_index == 4 ||
                    tile_index == 9 ||
                    tile_index == 14
                ) {
                    return;
                }

                if (
                    tiles[tile_index] !=
                    tiles[tile_index + 1]
                ) {
                    deselect_tile(tile_index);
                    tile_index++;
                    select_tile(tile_index);
                } else if (
                    tiles[tile_index] !=
                        tiles[tile_index + 2] &&
                    tile_index + 2 != 5 &&
                    tile_index + 2 != 10 &&
                    tile_index + 2 != 15
                ) {
                    deselect_tile(tile_index);
                    tile_index += 2;
                    select_tile(tile_index);
                }
                undefined_key_cont = 0;
            } else if (e.key == "a") {
                deselect_tile(tile_index, false);
                document
                    .getElementById("btn-xbox-a")
                    .animate(
                        animations.flash.keyframes,
                        animations.flash.options,
                    );
                setTimeout(() => {
                    console.log("chamou");
                    select_tile(tile_index, false);
                }, 500);

                if (tiles[tile_index].dataset.redirect) {
                    notify("Você será redirecionado em 6 segundos");
                    setTimeout(() => {
                        window.location.href =
                            tiles[tile_index].dataset.redirect;
                    }, 6000);
                }
                sounds.currentTime = 0;
                sounds["hud-open.wav"].play();
            } else {
                undefined_key_cont += 1;
                if (undefined_key_cont > 5) {
                    notify(
                        "Você está presionando teclas inválidas, só é permitido as setas e teclas: 'a', 'b', 'x' e 'y'",
                    );
                    undefined_key_cont = 0;
                }
            }
        }
    });

    document.getElementById("bt-menu-ok").addEventListener("click", () => {
        sounds.currentTime = 0;
        sounds["hud-open.wav"].play();
        document
            .getElementById("container-menu")
            .animate(animations.reducer.keyframes, animations.reducer.options);
        document
            .getElementById("container-menu-elements")
            .animate(animations.hidden.keyframes, animations.hidden.options);
        document.getElementById("container").style = "";

        setTimeout(() => {
            document.getElementsByTagName("main")[0].style =
                "opacity: 1; background-image: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent 50%, rgba(0,0,0,0.5)), url('/happy wars.jpg'); background-size: cover;";
            document.getElementById("menu").style = "display: none";
            document.getElementById("container").classList.remove("hidden");
            document.getElementById("container").classList.add("visible");
            sounds.currentTime = 0;
            sounds["startup-after-loading.wav"].play();

            tile_nodes[0].animate(
                animations.home_select_small.keyframes,
                animations.home_select_small.options,
            );
            tile_nodes[0]
                .querySelector(".tile-shine")
                ?.animate(
                    animations.home_shine_in.keyframes,
                    animations.home_shine_in.options,
                );
            control_menu_open = false;
        }, 600);
    });
    document.getElementById("bt-menu-no").addEventListener("click", () => {
        window.location.href = "https://www.google.com/search?q=gatinhos";
    });

    document.addEventListener("DOMContentLoaded", () => {
        let cont = 0;

        for (let element of tile_nodes) {
            for (var a = 0; a < 15; a++) {
                if (tiles[cont] == "") {
                    break;
                }
                cont++;
            }

            if (element.className.indexOf("tile-big") > 0) {
                tiles[cont] = element;
                tiles[cont + 1] = element;
                tiles[cont + 5] = element;
                tiles[cont + 6] = element;
            } else {
                tiles[cont] = element;
            }
            cont++;

            document.getElementsByTagName("main")[0].style =
                "background-color: #222";
            document
                .getElementById("container-menu")
                .animate(
                    animations.expand.keyframes,
                    animations.expand.options,
                );
            document
                .getElementById("container-menu-elements")
                .animate(animations.show.keyframes, animations.show.options);
        }
    });
</script>
