<!doctype html>
<html lang="pt-br">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <link href="../output.css" rel="stylesheet" />
        <title>Home - XBOX</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        width: 100dvw;
        height: 100dvh;
    }
</style>

<script defer>
    let all_elements = [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
    ];
    let element_index = 0;
    let element_parent = document.getElementsByClassName("element-parent");
    let element_child = document.getElementsByClassName("element-child");
    let undefined_key_cont = 0;
    const sounds = Object.fromEntries(
        ["tile-hover", "select-a", "startup-after-loading"].map((n) => {
            const a = new Audio(`/${n}.wav`);
            a.preload = "auto";
            return [n, a];
        }),
    );

    function select_remove_element(index, child = true) {
        if (all_elements[index].className.indexOf("element-big") > 0) {
            all_elements[index].classList.remove("select-big-parent");
            all_elements[index].classList.remove("select-big-child");
        } else {
            all_elements[index].classList.remove("select-small-parent");
            all_elements[index].classList.remove("select-small-child");
        }

        if (child) {
            all_elements[index].childNodes[0].classList.remove("select-child");
        }
    }

    function select_add_element(index, song = true) {
        if (all_elements[index].className.indexOf("element-big") > 0) {
            all_elements[index].classList.add("select-big-parent");
            all_elements[index].classList.add("select-big-child");
            all_elements[index].childNodes[0].classList.add("select-child");
        } else {
            all_elements[index].classList.add("select-small-parent");
            all_elements[index].classList.add("select-small-child");
            all_elements[index].childNodes[0].classList.add("select-child");
        }
        if (song) {
            sounds["tile-hover"].currentTime = 0;
            sounds["tile-hover"].play();
        }
    }

    document.addEventListener("keydown", (e) => {
        console.log(e.key);
        if (e.key == "ArrowUp") {
            console.log("para cima");

            if (element_index < 5) {
                return;
            }

            if (
                all_elements[element_index] != all_elements[element_index - 5]
            ) {
                select_remove_element(element_index);
                element_index -= 5;
                select_add_element(element_index);
            } else if (
                all_elements[element_index] !=
                    all_elements[element_index - 10] &&
                element_index - 10 > 5
            ) {
                select_remove_element(element_index);
                element_index -= 10;
                select_add_element(element_index);
            }

            undefined_key_cont = 0;
        } else if (e.key == "ArrowDown") {
            console.log("para baixo");

            if (element_index >= 10) {
                return;
            }

            if (
                all_elements[element_index] != all_elements[element_index + 5]
            ) {
                select_remove_element(element_index);
                element_index += 5;
                select_add_element(element_index);
            } else if (
                all_elements[element_index] !=
                    all_elements[element_index + 10] &&
                element_index + 10 > 9
            ) {
                select_remove_element(element_index);
                element_index += 10;
                select_add_element(element_index);
            }

            undefined_key_cont = 0;
        } else if (e.key == "ArrowLeft") {
            console.log("para esquerda");

            if (
                element_index == 0 ||
                element_index == 5 ||
                element_index == 10
            ) {
                return;
            }

            if (
                all_elements[element_index] != all_elements[element_index - 1]
            ) {
                select_remove_element(element_index);
                element_index--;
                select_add_element(element_index);
            } else if (
                all_elements[element_index] !=
                    all_elements[element_index - 2] &&
                element_index - 2 != -1 &&
                element_index - 2 != 4 &&
                element_index - 2 != 9
            ) {
                select_remove_element(element_index);
                element_index -= 2;
                select_add_element(element_index);
            }
            undefined_key_cont = 0;
        } else if (e.key == "ArrowRight") {
            console.log("para direita");

            console.log(element_index);
            if (
                element_index == 4 ||
                element_index == 9 ||
                element_index == 14
            ) {
                return;
            }

            if (
                all_elements[element_index] != all_elements[element_index + 1]
            ) {
                select_remove_element(element_index);
                element_index++;
                select_add_element(element_index);
            } else if (
                all_elements[element_index] !=
                    all_elements[element_index + 2] &&
                element_index + 2 != 5 &&
                element_index + 2 != 10 &&
                element_index + 2 != 15
            ) {
                select_remove_element(element_index);
                element_index += 2;
                select_add_element(element_index);
            }
            undefined_key_cont = 0;
        } else if (e.key == "a") {
            select_remove_element(element_index, false);
            setTimeout(() => {
                console.log("chamou");
                select_add_element(element_index, false);
                if (all_elements[element_index].dataset.redirect) {
                    window.location.href =
                        all_elements[element_index].dataset.redirect;
                }
            }, 500);

            sounds.currentTime = 0;
            sounds["select-a"].play();
        } else {
            undefined_key_cont += 1;
            if (undefined_key_cont > 5) {
                alert(
                    "Você está presionando teclas inválidas, só é permitido as setas e teclas: 'a', 'b', 'x' e 'y'",
                );
                undefined_key_cont = 0;
            }
        }
    });

    document.getElementById("bt-notice").addEventListener("click", () => {
        document.getElementsByTagName("main")[0].style =
            "background-image: url('/happy wars.jpg'); background-size: cover; transition: all 1s ease 0s";
        document.getElementById("container-notice").style = "display: none";
        setTimeout(() => {
            document.getElementById("container").classList.remove("hidden");
            document.getElementById("container").classList.add("visible");
            sounds.currentTime = 0;
            sounds["startup-after-loading"].play();

            element_parent[0].classList.add("select-small-parent");
            element_child[0].classList.add("select-small-child");
            element_child[0].classList.add("select-child");
            cont = 1;
        }, 300);
    });

    document.addEventListener("DOMContentLoaded", () => {
        let cont = 0;

        for (let element of element_parent) {
            for (var a = 0; a < 15; a++) {
                if (all_elements[cont] == "") {
                    break;
                }
                cont++;
            }

            if (element.className.indexOf("element-big") > 0) {
                all_elements[cont] = element;
                all_elements[cont + 1] = element;
                all_elements[cont + 5] = element;
                all_elements[cont + 6] = element;
            } else {
                all_elements[cont] = element;
            }
            cont++;
        }
    });
</script>
