<style>
    html,
    body {
        width: 100dvw;
        height: 100dvh;
    }
</style>

<script defer>
    document.getElementById("botao").addEventListener("click", () => {
        if (contador == 0) {
            elemento_pai[0].classList.add("select-pai");
            elemento_filho[0].classList.add("select-filho");
            contador = 1;
        } else {
            elemento_pai[contador - 1].classList.remove("select-pai");
            elemento_filho[contador - 1].classList.remove("select-filho");
            elemento_pai[contador].classList.add("select-pai");
            elemento_filho[contador].classList.add("select-filho");
            contador += 1;
        }
    });

    let contador = 0;
    let elemento_pai = document.getElementsByClassName("elemento-pai");
    let elemento_filho = document.getElementsByClassName("elemento-filho");
</script>
